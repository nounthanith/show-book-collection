# MongoDB connection string (MongoDB Atlas, local MongoDB, or Docker)
# Copy this file to .env.local and fill in your real connection string.
# For Atlas, use: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
# NOTE: URL-encode special characters in the password (e.g. @ becomes %40).
MONGODB_URI=mongodb://127.0.0.1:27017/personal_library

# Vercel Blob read/write token (required for PDF uploads in production).
# Create a Blob store in Vercel: Project > Storage > Create Blob Database,
# then add the BLOB_READ_WRITE_TOKEN to your Vercel environment variables.
BLOB_READ_WRITE_TOKEN=
